@model IEnumerable<ProjetoLivrariaDev.Models.LivroModel>

@{
    ViewData["Title"] = "Lista de Livros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Catálogo de Livros</h2>
    <a asp-action="Cadastrar" class="btn btn-success">Novo Livro</a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Autor</th>
            <th>Preço</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var livro in Model)
            {
                <tr>
                    <td>@livro.Id</td>
                    <td>@livro.Titulo</td>
                    <td>@livro.Autor</td>
                    <td>@livro.Preco.ToString("C")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">Nenhum livro cadastrado.</td>
            </tr>
        }
    </tbody>
</table>