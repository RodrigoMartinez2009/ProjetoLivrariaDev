@model IEnumerable<ProjetoLivrariaDev.Models.LivroModel>

@{
    ViewData["Title"] = "Lista de Livros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Catálogo de Livros</h2>
    <a asp-action="Cadastrar" class="btn btn-success">+ Novo Livro</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Autor</th>
                <th>Preço</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var livro in Model)
                {
                    <tr>
                        <td><span class="badge bg-secondary">#@livro.Id</span></td>
                        <td class="fw-bold">@livro.Titulo</td>
                        <td>@livro.Autor</td>
                        <td class="text-success fw-bold">@livro.Preco.ToString("C")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="4" class="text-center text-muted">Nenhum livro cadastrado até ao momento.</td>
                </tr>
            }
        </tbody>
    </table>
</div>